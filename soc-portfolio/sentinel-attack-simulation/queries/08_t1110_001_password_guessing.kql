// T1110.001 Password Guessing
// 5+ failed logons (EventID 4625) per host, account and source IP in the lookback window.
// Schedule: every 5 min, lookback 10 min. Severity: Medium.
// Entities: Host=Computer, Account=TargetAccount, IP=IpAddress.
SecurityEvent
| where EventID == 4625
| summarize FailedAttempts = count(), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated) by Computer, TargetAccount, IpAddress
| where FailedAttempts >= 5
